# 8. SEARCH & QUERY EVALUATOR
# =============================================================================

class QueryEngine:
    """Evaluates Lucene/KQL query expressions: 'service:payments AND level>=error'."""

    @staticmethod
    def evaluate(entry: LogEntry, query: str) -> bool:
        if not query or not query.strip():
            return True

        terms = query.strip().split()
        idx = 0
        while idx < len(terms):
            term = terms[idx]
            if term == "AND":
                idx += 1
                continue
            if term == "NOT":
                idx += 1
                if idx < len(terms) and QueryEngine._match_term(entry, terms[idx]):
                    return False
                idx += 1
                continue
            if not QueryEngine._match_term(entry, term):
                return False
            idx += 1
        return True

    @staticmethod
    def _match_term(entry: LogEntry, term: str) -> bool:
        if ":" in term:
            k, v = term.split(":", 1)
            v = v.strip('"\'').lower()
            val = str(entry.flattened.get(k) or getattr(entry, k, "")).lower()
            return v in val
        if term.startswith("level>="):
            target = term.replace("level>=", "").upper()
            weights = {"FATAL": 5, "ERROR": 4, "WARN": 3, "INFO": 2, "DEBUG": 1, "TRACE": 0}
            return weights.get(entry.level, 2) >= weights.get(target, 2)
        if term.startswith("/") and term.endswith("/"):
            try:
                return bool(re.search(term[1:-1], entry.message, re.IGNORECASE))
            except Exception:
                return False
        needle = term.lower()
        return needle in entry.message.lower() or needle in entry.service.lower()


