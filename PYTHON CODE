class IncidentReportExporter:
    """Assembles findings, patterns, and pinned logs into a clean Markdown postmortem."""

    @staticmethod
    def generate_markdown(
        title: str,
        severity: str,
        findings: List[AnomalyFinding],
        patterns: List[LogPattern],
        pinned_entries: List[LogEntry],
    ) -> str:
        now = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
        md = [
            f"# Incident Postmortem: {title}",
            f"**Severity**: `{severity}` | **Generated**: {now} | **Investigator**: SRE Team",
            "",
            "## 1. Executive Summary",
            "A system degradation was diagnosed locally via LogLens statistical log inspection.",
            f"- Total Anomalies Detected: **{len(findings)}**",
            f"- Mined Message Templates: **{len(patterns)}**",
            "",
            "## 2. Automated Findings",
        ]
        for f in findings:
            md.append(f"### [{f.severity}] {f.title}")
            md.append(f"- **Service**: `{f.service}`")
            md.append(f"- **Description**: {f.description}")
            md.append(f"- **Evidence Filter**: `{f.evidence_query}`\n")

        md.append("## 3. High-Frequency Log Templates")
        md.append("| Count | Dominant Level | Template |")
        md.append("| :--- | :--- | :--- |")
        for p in sorted(patterns, key=lambda x: x.count, reverse=True)[:5]:
            top_lvl = max(p.level_counts.items(), key=lambda k: k[1])[0]
            md.append(f"| {p.count} | `{top_lvl}` | `{p.template[:70]}` |")

        if pinned_entries:
            md.append("\n## 4. Evidence Timeline")
            for e in pinned_entries:
                ts = datetime.fromtimestamp(e.timestamp_ms / 1000, tz=timezone.utc).strftime("%H:%M:%S.%f")[:-3]
                md.append(f"- **{ts}** `[{e.level}]` **[{e.service}]**: {PiiScanner.redact_text(e.message)}")

        md.append("\n## 5. Corrective Action Items")
        md.append("- [ ] Investigate upstream gateway retry limits to halt cascading retry storms.")
        md.append("- [ ] Increase primary database connection pool limits.")
        md.append("- [ ] Add circuit-breaking between auth and payment microservices.")
        return "\n".join(md)


