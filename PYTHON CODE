def generate_sample_incident_ndjson() -> str:
    """Generates realistic multi-service logs with an injected DB connection pool failure."""
    lines = []
    base_time = int(time.time() * 1000) - (20 * 60 * 1000)

    # 1. Baseline healthy traffic
    for i in range(120):
        t = base_time + (i * 5000)
        req_id = f"req-{1000 + i}"
        lines.append(json.dumps({
            "timestamp": t,
            "level": "info",
            "service": "gateway",
            "message": "HTTP GET /api/v1/catalog returned 200 OK in 45ms for client 192.168.1.5",
            "metadata": {"request_id": req_id, "status": 200, "duration_ms": 45}
        }))
        lines.append(json.dumps({
            "timestamp": t + 20,
            "level": "info",
            "service": "auth-api",
            "message": f"Token validated successfully for user_{i}@corp.internal",
            "metadata": {"request_id": req_id, "api_key": "sk_live_sec9988776655443322"}
        }))

    # 2. Injected Database Exhaustion & Retry Storm
    incident_start = base_time + (10 * 60 * 1000)
    for i in range(80):
        t = incident_start + (i * 3500)
        txn_id = f"txn_{i:04x}"
        lines.append(json.dumps({
            "timestamp": t,
            "level": "error",
            "service": "payments",
            "message": f"Connection timeout to db-primary:5432 after 5000ms for txn_id: {txn_id} (retry {i % 3 + 1} of 3)",
            "metadata": {"request_id": f"req-err-{i}", "status": 504, "duration_ms": 5012}
        }))
        lines.append(json.dumps({
            "timestamp": t + 50,
            "level": "error",
            "service": "gateway",
            "message": "Upstream gateway error 504 Gateway Timeout while proxying request to /api/v1/charge",
            "metadata": {"request_id": f"req-err-{i}", "status": 504, "duration_ms": 5050}
        }))

    # 3. Fatal Crash
    for i in range(15):
        lines.append(json.dumps({
            "timestamp": incident_start + 180000 + (i * 2000),
            "level": "fatal",
            "service": "payments",
            "message": "PoolExhaustedError: Maximum connection pool size 50 reached on db-primary:5432",
            "metadata": {"status": 503}
        }))

    return "\n".join(lines)


def run_demo():
    print("=" * 80)
    print("  LOGLENS - LOCAL JSON LOG ANALYZER ENGINE (PYTHON PORT)")
    print("=" * 80)

    # 1. Ingestion
    print("\n[1/7] Ingesting & Detecting Format...")
    raw_ndjson = generate_sample_incident_ndjson()
    raw_lines = [json.loads(line) for line in raw_ndjson.strip().split("\n") if line]
    entries = [LogFormatDetector.normalize_entry(raw, idx) for idx, raw in enumerate(raw_lines)]
    print(f"  -> Ingested {len(entries)} lines.")
    print(f"  -> Detected Shape: {LogFormatDetector.detect_format(raw_lines[0])}")

    # 2. Drain Clustering
    print("\n[2/7] Mining Templates via Drain Clustering...")
    miner = DrainTemplateMiner(depth=4, sim_threshold=0.5)
    for e in entries:
        setattr(e, "pattern_id", miner.add_log_message(e))
    miner.compute_sparklines(entries)
    print(f"  -> Collapsed {len(entries)} raw lines into {len(miner.clusters)} pattern templates:")
    for pat in sorted(miner.clusters, key=lambda p: p.count, reverse=True):
        lvl_str = ", ".join(f"{k}:{v}" for k, v in pat.level_counts.items())
        print(f"     [{pat.count:3d}x] ({lvl_str}) {pat.template}")

    # 3. Trace Reconstruction
    print("\n[3/7] Reconstructing Distributed Traces...")
    waterfalls = TraceReconstructor.build_waterfalls(entries)
    print(f"  -> Reconstructed {len(waterfalls)} traces.")
    if waterfalls:
        top_err = waterfalls[0]
        print(f"  -> Failing Trace: {top_err.trace_id} ({top_err.total_duration_ms:.0f}ms)")
        for s in top_err.spans:
            print(f"     +{s.relative_offset_ms:4.0f}ms [{s.level}] [{s.service}] {s.message[:65]}")

    # 4. Anomaly Findings
    print("\n[4/7] Running Statistical Anomaly Detection...")
    findings = AnomalyDetector.detect_anomalies(entries, miner.clusters)
    for f in findings:
        print(f"  * [{f.severity}] {f.title}")
        print(f"    Evidence Query: {f.evidence_query}")

    # 5. Time-Window Diff
    print("\n[5/7] Time-Window Differential Analysis...")
    t_min = min(e.timestamp_ms for e in entries)
    t_max = max(e.timestamp_ms for e in entries)
    t_mid = t_min + (t_max - t_min) // 2
    diff = TimeWindowDiff.compare_windows(entries, (t_min, t_mid), (t_mid, t_max))
    print(f"  -> Newly Emerged Templates in Incident: {len(diff['new_patterns'])}")
    for np in diff['new_patterns']:
        print(f"     + NEW [{np.target_count}x]: {np.template}")

    # 6. PII Masking
    print("\n[6/7] PII & Secret Redaction...")
    print(f"  -> Detected: {PiiScanner.scan_entries(entries)}")
    sample_raw = entries[1].message
    print(f"  -> Before: {sample_raw}")
    print(f"  -> After:  {PiiScanner.redact_text(sample_raw)}")

    # 7. Incident Markdown
    print("\n[7/7] Markdown Incident Report Generation...")
    md = IncidentReportExporter.generate_markdown(
        title="Primary DB Pool Exhaustion",
        severity="SEV-1",
        findings=findings,
        patterns=miner.clusters,
        pinned_entries=[e for e in entries if e.level in ("ERROR", "FATAL")][:2],
    )
    print("\n" + "=" * 35 + " [PREVIEW] " + "=" * 35)
    print(md[:600] + "\n...")
    print("=" * 80)
    print("SUCCESS: Full LogLens pipeline executed cleanly in Python!\n")


if __name__ == "__main__":
    run_demo()
