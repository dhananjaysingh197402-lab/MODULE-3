# 5. STATISTICAL ANOMALY & FINDINGS DETECTOR
# =============================================================================

class AnomalyDetector:
    """Flags error spikes, latency outliers, silent deadlocks, and first-seen patterns."""

    @staticmethod
    def detect_anomalies(entries: List[LogEntry], patterns: List[LogPattern]) -> List[AnomalyFinding]:
        findings: List[AnomalyFinding] = []
        if len(entries) < 10:
            return findings

        entries_sorted = sorted(entries, key=lambda x: x.timestamp_ms)
        min_t = entries_sorted[0].timestamp_ms
        max_t = entries_sorted[-1].timestamp_ms

        # 1. Error Rate Spikes per Service
        svc_total = defaultdict(int)
        svc_errors = defaultdict(int)
        for e in entries_sorted:
            svc_total[e.service] += 1
            if e.level in ("ERROR", "FATAL"):
                svc_errors[e.service] += 1

        for svc, total in svc_total.items():
            err_count = svc_errors[svc]
            rate = (err_count / total) * 100
            if rate > 15.0 and err_count >= 5:
                findings.append(
                    AnomalyFinding(
                        type="ERROR_BURST",
                        severity="CRITICAL" if rate > 40 else "HIGH",
                        service=svc,
                        title=f"Error Spike in service '{svc}' ({rate:.1f}%)",
                        description=f"Service '{svc}' suffered {err_count} failures across {total} events ({rate:.1f}% failure rate).",
                        timestamp_start_ms=min_t,
                        timestamp_end_ms=max_t,
                        evidence_query=f'service:"{svc}" AND level>=error',
                        metric_value=rate,
                    )
                )

        # 2. Latency Outliers
        latencies = [e.duration_ms for e in entries_sorted if e.duration_ms and e.duration_ms > 0]
        if len(latencies) >= 5:
            latencies.sort()
            p50 = latencies[int(len(latencies) * 0.50)]
            p90 = latencies[int(len(latencies) * 0.90)]
            p95 = latencies[int(len(latencies) * 0.95)]
            threshold = max(p90 * 2.5, p95 * 1.8, p50 * 3.0)

            outliers = [e for e in entries_sorted if e.duration_ms and e.duration_ms >= threshold]
            if outliers:
                worst = max(outliers, key=lambda x: x.duration_ms or 0)
                findings.append(
                    AnomalyFinding(
                        type="LATENCY_OUTLIER",
                        severity="HIGH",
                        service=worst.service,
                        title=f"Severe Latency Outlier ({worst.duration_ms:.0f}ms in {worst.service})",
                        description=f"Detected {len(outliers)} requests exceeding threshold ({threshold:.0f}ms). Worst spike: {worst.duration_ms:.0f}ms.",
                        timestamp_start_ms=outliers[0].timestamp_ms,
                        timestamp_end_ms=outliers[-1].timestamp_ms,
                        evidence_query=f'service:"{worst.service}" AND duration>{int(threshold)}',
                        metric_value=worst.duration_ms,
                        baseline_value=p50,
                    )
                )

        # 3. Silent Logging Deadlock / Thread Stall
        svc_logs: Dict[str, List[LogEntry]] = defaultdict(list)
        for e in entries_sorted:
            svc_logs[e.service].append(e)

        for svc, s_logs in svc_logs.items():
            if len(s_logs) < 15: continue
            for i in range(len(s_logs) - 1):
                gap_sec = (s_logs[i + 1].timestamp_ms - s_logs[i].timestamp_ms) / 1000.0
                if gap_sec >= 30.0:  # Silence for >30s
                    findings.append(
                        AnomalyFinding(
                            type="SILENT_GAP",
                            severity="MEDIUM",
                            service=svc,
                            title=f"Silent Logging Gap in '{svc}' ({gap_sec:.0f}s)",
                            description=f"Service '{svc}' went silent for {gap_sec:.0f} seconds, indicating potential threadpool starvation or worker deadlock.",
                            timestamp_start_ms=s_logs[i].timestamp_ms,
                            timestamp_end_ms=s_logs[i + 1].timestamp_ms,
                            evidence_query=f'service:"{svc}"',
                            metric_value=gap_sec,
                        )
                    )
                    break

        # 4. First-Seen Failure Patterns
        mid_ms = min_t + int((max_t - min_t) * 0.4)
        for pat in patterns:
            has_error = any(pat.level_counts.get(lvl, 0) > 0 for lvl in ("ERROR", "FATAL"))
            if has_error and pat.first_seen_ms >= mid_ms:
                findings.append(
                    AnomalyFinding(
                        type="FIRST_SEEN_FAILURE",
                        severity="CRITICAL",
                        service=next(iter(pat.services)),
                        title=f"New Error Template Emerged: {pat.template[:45]}...",
                        description=f"Template '{pat.template}' with {pat.count} errors first emerged during the incident window.",
                        timestamp_start_ms=pat.first_seen_ms,
                        timestamp_end_ms=pat.last_seen_ms,
                        evidence_query='level>=error',
                        metric_value=float(pat.count),
                    )
                )

        return findings


# =============================================================================
# 6. TIME-WINDOW DIFFERENTIAL ANALYZER
# =============================================================================

@dataclass
class PatternDelta:
    template: str
    baseline_count: int
    target_count: int
    delta: int
    percent_change: float
    is_new: bool
    is_disappeared: bool


class TimeWindowDiff:
    """Compares baseline vs target time windows to identify regressions."""

    @staticmethod
    def compare_windows(
        entries: List[LogEntry],
        baseline_range: Tuple[int, int],
        target_range: Tuple[int, int],
    ) -> Dict[str, Any]:
        miner_b = DrainTemplateMiner()
        miner_t = DrainTemplateMiner()

        b_entries = [e for e in entries if baseline_range[0] <= e.timestamp_ms <= baseline_range[1]]
        t_entries = [e for e in entries if target_range[0] <= e.timestamp_ms <= target_range[1]]

        for e in b_entries: miner_b.add_log_message(e)
        for e in t_entries: miner_t.add_log_message(e)

        b_map = {p.template: p.count for p in miner_b.clusters}
        t_map = {p.template: p.count for p in miner_t.clusters}

        deltas: List[PatternDelta] = []
        for tmpl in set(b_map.keys()) | set(t_map.keys()):
            bc = b_map.get(tmpl, 0)
            tc = t_map.get(tmpl, 0)
            diff = tc - bc
            pct = ((diff / bc) * 100.0) if bc > 0 else (100.0 if tc > 0 else 0.0)
            deltas.append(
                PatternDelta(
                    template=tmpl,
                    baseline_count=bc,
                    target_count=tc,
                    delta=diff,
                    percent_change=pct,
                    is_new=(bc == 0 and tc > 0),
                    is_disappeared=(bc > 0 and tc == 0),
                )
            )

        deltas.sort(key=lambda d: abs(d.delta), reverse=True)
        return {
            "baseline_count": len(b_entries),
            "target_count": len(t_entries),
            "new_patterns": [d for d in deltas if d.is_new],
            "disappeared_patterns": [d for d in deltas if d.is_disappeared],
            "frequency_deltas": deltas,
        }


